# GoshBuzz Pakistan — Environment Setup
# Use this file to define any required API credentials or keys.
# NEVER commit actual secrets to this file or source control.
# Real values go in Vercel → Project → Settings → Environment Variables (Production AND Preview).

# WhatsApp Direct Configuration
VITE_WHATSAPP_NUMBER=923126999078

# ---- Card payments (Stripe) + automatic PDF delivery ----
# Public site address, used in Stripe redirects and email links (no trailing slash).
SITE_URL=https://goshbuzz.com

# Stripe: dashboard.stripe.com → Developers → API keys. Use sk_test_... until you go live.
STRIPE_SECRET_KEY=sk_test_your_key_here
# Stripe: Developers → Webhooks → your endpoint → Signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Random string, 32+ characters, signs download links. Generate: openssl rand -hex 32
DOWNLOAD_TOKEN_SECRET=replace_with_64_hex_characters
# How many days the emailed download links work (1-30).
DOWNLOAD_LINK_DAYS=7

# Google Cloud service account (JSON key). Paste the whole JSON on one line.
GCP_SERVICE_ACCOUNT_JSON={"type":"service_account", "...":"..."}
# Private Cloud Storage bucket that holds the PDFs (not public).
DELIVERY_BUCKET=goshbuzz-deliverables

# Resend (resend.com): API key and a verified sender on your domain.
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=GoshBuzz <orders@goshbuzz.com>
# Where customer replies go. Use a Gmail address: goshbuzz.com has no mailbox.
EMAIL_REPLY_TO=
